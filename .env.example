# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────
# From Supabase: Settings → Database → Connection string (URI mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Supabase Storage ────────────────────────────────────
# From Supabase: Settings → API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Paystack ────────────────────────────────────────────
# From Paystack: Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
# Must match what you set in Paystack webhook settings
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# ── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=beats@yourdomain.com
EMAIL_FROM_NAME=BeatVault

# ── Admin ───────────────────────────────────────────────
# A long random string — used to log in to /admin
ADMIN_SECRET=change_this_to_a_long_random_secret_string

# ── License Prices (in Naira) ───────────────────────────
PRICE_WAV_ADDON=5000
PRICE_STEMS_ADDON=15000
